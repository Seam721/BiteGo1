# This project uses Vite, so use VITE_ variables (not NEXT_PUBLIC_).
# Customer frontend calls the Express backend for catalog, orders, and payments.
VITE_API_URL=http://localhost:3000
# Supabase browser settings are provided for future direct client use; never put a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
BACKEND_URL=http://localhost:3000
