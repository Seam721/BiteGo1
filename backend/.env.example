PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public key may be used for catalog reads; it cannot perform privileged payment writes.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# REQUIRED for payment record creation under the current RLS policies.
# Get this from Supabase Dashboard > Project Settings > API Keys.
# Keep it server-only. Never put it in frontend/admin .env files or GitHub.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SECRET_KEY_HERE
# Comma-separated exact customer/admin origins; local development example:
CORS_ORIGIN=http://localhost:8443,http://localhost:5173
